NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Only set to a known proxy IP/CIDR or hop count behind a controlled edge.
# TRUST_PROXY=
DATABASE_URL=postgres://mmp:mmp@localhost:5432/mmp
WEB_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173

# Use demo mode for a local walkthrough. Testnet mode only watches validated
# XRP Ledger Testnet payments; the server never holds customer or merchant keys.
PAYMENT_MODE=demo
DEMO_PAYMENTS_ENABLED=true
# Keep device cycle starts disabled unless the deployment is ready to enforce
# active operator budgets and approved payees for every device.
DEVICE_CYCLE_START_ENABLED=false
MERCHANT_XRPL_ADDRESS=
XRPL_WS_URL=wss://s.altnet.rippletest.net:51233

# Local demo auth is disabled. Production must use Auth0 OIDC. Merchant API
# routes remain unavailable for production until tenant scoping is complete.
AUTH_MODE=off
# OIDC_ISSUER=https://your-tenant.us.auth0.com/
# OIDC_AUDIENCE=https://api.relaypay.example
# OIDC_ORGANIZATION_CLAIM=org_id

# Optional browser dashboard sign-in (Auth0 SPA application, PKCE; no client secret).
# Set all three required values together. Add the app origin to Auth0 Allowed Callback,
# Allowed Logout, and Allowed Web Origins. Organization is optional; otherwise sign-in asks.
# VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
# VITE_AUTH0_CLIENT_ID=your-spa-client-id
# VITE_AUTH0_AUDIENCE=https://api.relaypay.example
# VITE_AUTH0_ORGANIZATION=org_xxxxxxxxxxxxxxxx
