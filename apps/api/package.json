    "@mmp/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "pg": "8.16.3",
    "typebox": "1.1.14",
    "xrpl": "4.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.15.6",
